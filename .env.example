# --- Asistente conversacional -------------------------------------------
# ollama (real) | fake (respuesta fija para demos sin modelo)
PYME_LLM_PROVIDER=fake

# Si se define, /v1/chat y /v1/applications exigen el header X-API-Key (la pantalla pide la clave)
PYME_API_KEY=cambia-esto
# Si se define, la consola del analista exige X-Analyst-Key (en producción: SSO + RBAC)
PYME_ANALYST_KEY=cambia-esto-analista

# Ollama
PYME_OLLAMA_BASE_URL=http://localhost:11434
PYME_OLLAMA_MODEL=llama3.2
PYME_OLLAMA_TIMEOUT=60

# --- Journey de liquidez ---------------------------------------------------
# plantilla (determinista, por defecto) | crewai (requiere requirements-crewai.txt y un modelo)
PYME_NARRATOR=plantilla
# Formato LiteLLM: ollama/llama3.2, anthropic/<modelo>, openai/<modelo>, ...
PYME_CREWAI_MODEL=ollama/llama3.2
PYME_CREWAI_BASE_URL=http://localhost:11434

# --- Marca (el logo y los colores se editan en la carpeta brand/) ----------
PYME_BRAND_NAME=Periferia IT Group
PYME_BRAND_TAGLINE=Liquidez Factura · Banca Pyme
PYME_BRAND_DIR=brand
